# Needed only for the "Frage stellen" / "Beleg prüfen" modes; search works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings (defaults shown):
# Zotero's local API (Zotero 7+, Settings > Advanced: allow other applications to communicate).
# ZOTERO_API_URL=http://127.0.0.1:23119/api
# Embedding model. multilingual-e5-base finds more, multilingual-e5-small indexes faster.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Cross-encoder for precise ranking; leave empty to switch it off (faster, less precise).
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
