{
  "manifest_version": 2,
  "name": "Caitation for Zotero",
  "version": "0.2.1",
  "description": "Ähnliche Paper, semantische Suche und Belegprüfung für die eigene Bibliothek – lokal über die Caitation-App.",
  "author": "Tobias Schmidt",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "caitation@piece-of-schmidt",
      "update_url": "https://raw.githubusercontent.com/Piece-Of-Schmidt/caitation/main/plugin/updates.json",
      "strict_min_version": "8.0",
      "strict_max_version": "9.*"
    }
  }
}
